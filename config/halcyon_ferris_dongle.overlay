/*
 * Dongle-only devicetree overlay.
 *
 * The right half forwards Cirque touchpad events to the dongle, where
 * &trackpad_listener (from the splitkb mod_cirque_central shield) turns
 * them into mouse movement. While the Mouse layer (layer 4, held via the
 * right inner thumb key) is active:
 *   - dragging on the touchpad scrolls instead of moving the cursor
 *   - tapping the touchpad is a right click instead of a left click
 *
 * Cursor speed: `&zip_xy_scaler <mul> <div>` (base processors). Layer
 * overrides run first, so this does not affect scroll speed.
 *
 * Scroll tuning: add `&zip_scroll_scaler 1 4` after the mapper to slow
 * scrolling, or `&zip_scroll_transform INPUT_TRANSFORM_Y_INVERT` to flip
 * direction.
 *
 * &drag_lock (in-repo module, src/input_processor_drag_lock.c) must be the
 * first processor in every chain. It (a) forwards only real button
 * transitions - the Cirque driver repeats the button state in every packet
 * and ZMK reference-counts button presses, so without it a (double-tap) drag
 * stays stuck after lifting the finger - and (b) implements a drag lock:
 * lifting the finger mid-drag keeps the button held for `timeout-ms`, so you
 * can reposition and keep dragging; after that it releases. A continued drag
 * ends after `soft-drag-idle-ms` without motion (the chip does not report
 * the lift in that case).
 */

#include <input/processors.dtsi>
#include <zephyr/dt-bindings/input/input-event-codes.h>

/* USB serial console for CONFIG_ZMK_USB_LOGGING (see halcyon_ferris_dongle.conf);
 * the halcyon_dongle board does not define one. Harmless when logging is off. */
/ {
    chosen {
        zephyr,console = &cdc_acm_uart;
    };
};

&zephyr_udc0 {
    cdc_acm_uart: cdc_acm_uart {
        compatible = "zephyr,cdc-acm-uart";
    };
};

/ {
    /* The Cirque reports a tap as BTN_TOUCH (ZMK: left button); map it to
     * BTN_1 (ZMK: right button). */
    tap_to_right_click: tap_to_right_click {
        compatible = "zmk,input-processor-code-mapper";
        #input-processor-cells = <0>;
        type = <INPUT_EV_KEY>;
        map = <INPUT_BTN_TOUCH INPUT_BTN_1>;
    };

    drag_lock: drag_lock {
        compatible = "zmk,input-processor-drag-lock";
        #input-processor-cells = <0>;
        timeout-ms = <500>;
        soft-drag-idle-ms = <1000>;
    };
};

&trackpad_listener {
    /* 2x cursor speed on every layer. */
    input-processors = <&drag_lock &zip_xy_scaler 2 1>;

    scroller {
        layers = <4>;
        input-processors = <&drag_lock &zip_xy_to_scroll_mapper &tap_to_right_click>;
    };
};
