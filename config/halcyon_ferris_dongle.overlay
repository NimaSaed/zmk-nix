/*
 * Dongle-only devicetree overlay.
 *
 * The right half forwards Cirque touchpad events to the dongle, where
 * &trackpad_listener (from the splitkb mod_cirque_central shield) turns
 * them into mouse movement. While the Mouse layer (layer 4, held via the
 * right inner thumb key) is active:
 *   - dragging on the touchpad scrolls instead of moving the cursor
 *   - tapping the touchpad is a right click instead of a left click
 *
 * Cursor speed: `&zip_xy_scaler <mul> <div>` (base processors). Layer
 * overrides run first, so this does not affect scroll speed.
 *
 * Scroll tuning: add `&zip_scroll_scaler 1 4` after the mapper to slow
 * scrolling, or `&zip_scroll_transform INPUT_TRANSFORM_Y_INVERT` to flip
 * direction.
 *
 * &drag_lock (in-repo module, src/input_processor_drag_lock.c) must be the
 * first processor in every chain; its parameter is the button to emit. It
 * (a) forwards only real button transitions - the Cirque driver repeats the
 * button state in every packet and ZMK reference-counts button presses, so
 * without it a (double-tap) drag stays stuck after lifting the finger;
 * (b) implements a drag lock: lifting the finger mid-drag keeps the button
 * held for `timeout-ms`, so you can reposition and keep dragging, after that
 * it releases, and a continued drag ends after `soft-drag-idle-ms` without
 * motion or when you tap; (c) swallows the chip's misreads: a button that
 * follows a short cursor stroke (the chip took it for a tap) and the late
 * tap meant to end a drag that the timeout already released.
 */

#include <input/processors.dtsi>
#include <zephyr/dt-bindings/input/input-event-codes.h>

/* USB serial console for CONFIG_ZMK_USB_LOGGING (see halcyon_ferris_dongle.conf);
 * the halcyon_dongle board does not define one. Harmless when logging is off. */
/ {
    chosen {
        zephyr,console = &cdc_acm_uart;
    };
};

&zephyr_udc0 {
    cdc_acm_uart: cdc_acm_uart {
        compatible = "zephyr,cdc-acm-uart";
    };
};

/ {
    /* &drag_lock takes the button code to emit as its parameter (left on the
     * base chain, right on the Mouse layer's chain) and latches it at the
     * press, so a layer change between press and release can never leave a
     * button stuck (ZMK counts presses per button). */
    drag_lock: drag_lock {
        compatible = "zmk,input-processor-drag-lock";
        #input-processor-cells = <1>;
        /* Reposition window after lifting mid-drag. Any touch-and-move inside
         * it continues the drag, so keep it short (libinput uses 300 ms);
         * 500 ms made "click, move, lift, move again" continue as a drag. */
        timeout-ms = <300>;
        soft-drag-idle-ms = <1000>;
        drag-threshold = <8>;
        /* A press within this time after a forwarded tap is always accepted
         * (double tap, tap-and-hold). */
        tap-drag-window-ms = <500>;
        /* A motion-less press this soon after the timeout released a drag is
         * the (late-reported) tap that was meant to end it, not a click. */
        tap-after-drag-ms = <350>;
        /* The chip takes a short cursor stroke for a tap (reported 200-300 ms
         * after the lift) and the next touch for a drag: "lift, re-centre,
         * continue" dragged, flick-scrolling right-clicked. A press within
         * tap-after-stroke-ms after a stroke of <= short-stroke-ms that moved
         * >= tap-max-stroke counts is swallowed. A fast double-tap-and-hold
         * right after a *long* move still drags; after a quick flick, pause
         * a moment first. Tune with the TRACE line "press: last stroke ...". */
        stroke-gap-ms = <150>;
        tap-after-stroke-ms = <320>;
        short-stroke-ms = <250>;
        /* Measured: misread flicks were 37-155 counts; a finger adjusting
         * onto a target before a real tap was 10-17 counts. */
        tap-max-stroke = <24>;
    };
};

&trackpad_listener {
    /* 2x cursor speed on every layer; taps / drags use the left button. */
    input-processors = <&drag_lock INPUT_BTN_0 &zip_xy_scaler 2 1>;

    scroller {
        layers = <4>;
        /* Mouse layer: motion scrolls, taps / drags use the right button. */
        input-processors = <&drag_lock INPUT_BTN_1 &zip_xy_to_scroll_mapper>;
    };
};
